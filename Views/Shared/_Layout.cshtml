<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — MahdiFit Hub</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">M</span>
            <span>MahdiFit<small>نظام إدارة النادي</small></span>
        </a>
        <nav>
            <a asp-controller="Home" asp-action="Index">لوحة المتابعة</a>
            <a asp-controller="Sessions" asp-action="Index">الحصص والحجوزات</a>
            @if (User.IsInRole(UserRoles.Admin))
            {
                <a asp-controller="People" asp-action="Index">الأعضاء والفريق</a>
                <a asp-controller="Plans" asp-action="Index">باقات الاشتراك</a>
            }
        </nav>
        <div class="user-panel">
            <strong>@User.Identity.Name</strong>
            <span>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button class="link-button" type="submit">تسجيل الخروج</button>
            </form>
        </div>
    </aside>
}
<main class="@(User.Identity?.IsAuthenticated == true ? "shell" : "guest-shell")">
    @if (TempData["Success"] is string success)
    {
        <div class="notice success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="notice error">@error</div>
    }
    @RenderBody()
</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
